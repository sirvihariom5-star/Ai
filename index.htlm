<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>StudyTwin AI</title>

<style>

body{
    margin:0;
    padding:20px;
    font-family:Arial,sans-serif;
    background:linear-gradient(135deg,#667eea,#764ba2);
    min-height:100vh;
}

.container{
    max-width:600px;
    margin:auto;
}

h1{
    color:white;
    text-align:center;
}

.subtitle{
    color:white;
    text-align:center;
    margin-bottom:25px;
}

.box{
    background:white;
    padding:20px;
    border-radius:20px;
}

textarea{
    width:100%;
    height:120px;
    padding:15px;
    box-sizing:border-box;
    border:2px solid #ddd;
    border-radius:10px;
    font-size:16px;
    resize:none;
}

select{
    width:100%;
    padding:12px;
    margin-top:10px;
    border-radius:10px;
    border:1px solid #ddd;
}

button{
    width:100%;
    padding:15px;
    margin-top:15px;
    border:none;
    border-radius:10px;
    background:#667eea;
    color:white;
    font-size:17px;
    font-weight:bold;
    cursor:pointer;
}

button:disabled{
    background:#999;
    cursor:not-allowed;
}

#results{
    display:none;
    margin-top:20px;
}

.card{
    background:white;
    padding:20px;
    margin-top:15px;
    border-radius:15px;
}

.card h2{
    color:#667eea;
}

.card p{
    line-height:1.6;
    white-space:pre-wrap;
}

#error{
    display:none;
    background:#ffdddd;
    color:#b00000;
    padding:15px;
    margin-top:15px;
    border-radius:10px;
}

</style>

</head>

<body>

<div class="container">

<h1>🎓 StudyTwin AI</h1>

<p class="subtitle">
Ask Once. Understand Twice.
</p>

<div class="box">

<textarea
id="question"
placeholder="Ask your study question here...

Example: Explain Photosynthesis">
</textarea>

<select id="language">
<option>English</option>
<option>Hindi</option>
<option>Hinglish</option>
</select>

<select id="mode">
<option>Simple Explanation</option>
<option>Detailed Explanation</option>
<option>Exam Mode</option>
</select>

<button id="askButton">
🤖 Ask Two AI Teachers
</button>

<div id="error"></div>

</div>

<div id="results">

<div class="card">
<h2>🤖 AI Teacher 1</h2>
<p id="answer1"></p>
</div>

<div class="card">
<h2>🧠 AI Teacher 2</h2>
<p id="answer2"></p>
</div>

</div>

</div>

<script>

// Your live Render backend
const BACKEND_URL = "https://studytwin-backend.onrender.com";

const askButton = document.getElementById("askButton");

askButton.addEventListener("click", async function(){

    const question =
    document.getElementById("question").value.trim();

    const language =
    document.getElementById("language").value;

    const mode =
    document.getElementById("mode").value;

    const results =
    document.getElementById("results");

    const answer1 =
    document.getElementById("answer1");

    const answer2 =
    document.getElementById("answer2");

    const errorBox =
    document.getElementById("error");


    // Check question
    if(question === ""){

        alert("Please enter a question first!");

        return;

    }


    // Show loading
    askButton.disabled = true;

    askButton.innerText =
    "⏳ AI Teachers are thinking...";

    errorBox.style.display = "none";

    results.style.display = "block";

    answer1.innerText =
    "Teacher 1 is preparing your explanation...";

    answer2.innerText =
    "Teacher 2 is preparing your explanation...";


    try{

        // Send question to backend
        const response = await fetch(
            BACKEND_URL + "/ask",
            {
                method:"POST",

                headers:{
                    "Content-Type":"application/json"
                },

                body:JSON.stringify({

                    question:question,

                    language:language,

                    model:mode

                })

            }
        );


        // Check server response
        if(!response.ok){

            throw new Error(
                "Server error: " + response.status
            );

        }


        // Convert response to JSON
        const data =
        await response.json();


        // Display AI answers
        answer1.innerText =
        data.teacher1 || "No answer received.";

        answer2.innerText =
        data.teacher2 || "No answer received.";


        // Scroll to results
        results.scrollIntoView({
            behavior:"smooth"
        });


    }catch(error){

        console.error(error);

        errorBox.style.display = "block";

        errorBox.innerText =
        "❌ Something went wrong. Please try again.";

        answer1.innerText = "";

        answer2.innerText = "";

    }


    // Reset button
    askButton.disabled = false;

    askButton.innerText =
    "🤖 Ask Two AI Teachers";

});

</script>

</body>

</html>
